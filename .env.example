DATABASE_URL="file:./dev.db"
JWT_SECRET="your-jwt-secret-key-at-least-32-chars-long"

# Supabase (مطلوب لتخزين الشعار بشكل دائم على Vercel)
# احصل على هذه القيم من لوحة Supabase → Settings → API
# SUPABASE_SERVICE_ROLE_KEY سري: ضعه في Vercel Environment Variables فقط، ولا تضعه في الكود الواجهي أو السجلات.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
